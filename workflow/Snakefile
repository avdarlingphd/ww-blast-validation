# ww-blast-validation — Snakemake pipeline
# BLAST-validate candidate pathogen detections (per sample x taxid): extract the reads the detector
# assigned to that taxid -> subsample -> blastn vs nt -> classify TRUE/FALSE positive.
#
# Detection-source agnostic: `detection_source` (kraken | bowtie) selects the method-specific EXTRACT
# rule and routes the whole output tree into results/<source>/, so kraken and bowtie candidate sets
# never collide. Everything downstream of extraction (blast, classify) is shared.
#
# Pipeline:  extract_sample  ->  blast_pair  ->  classify
#   extract_sample  ONE job per SAMPLE: read the ~5 GB .kraken + FASTQs ONCE and write the per-taxid
#                   R1/R2 FASTAs for ALL of that sample's taxids in a single pass. A per-sample
#                   sentinel (flags/{sample}.extracted) tells the DAG the group is done.
#   blast_pair      per (sample,taxid): subsample to max_reads, blastn vs nt
#   classify        aggregate all pairs -> blast_false_positive_report.tsv
#
# Run (from repo root, on the cluster):
#   snakemake -p --profile profiles/slurm
# Dry run / DAG (no executor needed):
#   snakemake -n
import os
import pandas as pd

configfile: "config/config.yaml"

SRC        = config["detection_source"]                       # "kraken" or "bowtie"
RESULTS    = config["results_dir"].rstrip("/") + "/" + SRC
FASTA_TREE = RESULTS + "/fasta"                               # extracted per-pair FASTAs land here
BLAST_TREE = RESULTS + "/blast"
FLAG_DIR   = RESULTS + "/flags"                               # per-sample "extraction done" sentinels

wildcard_constraints:
    taxid  = r"\d+",
    sample = r"[A-Za-z0-9]+",

# ---- candidate (sample, taxid) pairs from the list -----------------------------------------------
_df = pd.read_csv(config["taxid_list"], sep="\t", header=None, names=["sample", "taxid"], dtype=str)
_df = _df.dropna()
PAIRS   = [(r.sample, r.taxid) for r in _df.itertuples()]
SAMPLES = sorted(_df["sample"].unique())

def fasta(s, t, read):
    return f"{FASTA_TREE}/blast_validation_{s}_{t}/{s}_taxid_{t}_{read}.fasta"

def blast_outputs():
    out = []
    for s, t in PAIRS:
        d = f"{BLAST_TREE}/blast_validation_{s}_{t}"
        out += [f"{d}/{s}_taxid_{t}_R1_blast_results.tsv", f"{d}/{s}_taxid_{t}_R2_blast_results.tsv"]
    return out

rule all:
    input:
        RESULTS + "/blast_false_positive_report.tsv"

# ================================================================================================
# EXTRACT — method-specific, switched by detection_source, and batched PER SAMPLE. Each variant reads
# the sample's classifier output ONCE and writes every fasta(sample, taxid, read) for that sample,
# then touches the sentinel flags/{sample}.extracted. Downstream rules stay source-agnostic.
# ================================================================================================
if SRC == "kraken":
    # Read {sample}.kraken + FASTQs once; write per-taxid FASTAs for all of the sample's taxids.
    rule extract_sample:
        input:
            kraken  = config["kraken_dir"] + "/{sample}.kraken",
            kreport = config["kraken_dir"] + "/{sample}.kreport",
            r1_fq   = config["fastq_dir"]  + "/{sample}_R1.fastq.gz",
            r2_fq   = config["fastq_dir"]  + "/{sample}_R2.fastq.gz",
        output:
            flag = touch(FLAG_DIR + "/{sample}.extracted"),
        params:
            python     = config["python"],
            taxid_list = config["taxid_list"],
            out_dir    = FASTA_TREE,
        resources:
            mem_mb  = 16000,
            runtime = 360,   # minutes (one pass over the ~5 GB .kraken + both FASTQs)
        shell:
            "{params.python} workflow/scripts/extract_kraken_sample.py "
            "--sample {wildcards.sample} --kraken {input.kraken} --kreport {input.kreport} "
            "--r1 {input.r1_fq} --r2 {input.r2_fq} "
            "--taxid_list {params.taxid_list} --out_dir {params.out_dir}"

elif SRC == "bowtie":
    # Placeholder: a per-sample bowtie extract rule (same fasta() outputs + sentinel) goes here. Kept
    # as an explicit branch so kraken-vs-bowtie stays a config switch, not a fork. Not implemented.
    raise WorkflowError(
        "detection_source: bowtie — extract rule not implemented yet. "
        "Add a bowtie extract_sample rule producing fasta(sample, taxid, read) + the {sample} sentinel, "
        "then remove this guard."
    )
else:
    raise WorkflowError(f"detection_source must be 'kraken' or 'bowtie', got: {SRC!r}")

# ================================================================================================
# BLAST — one job per (sample, taxid). Depends on the per-sample extraction sentinel; the specific
# per-pair FASTAs (created by extract_sample, empty if zero reads) are read inside blast_pair.sh,
# which already handles empty/missing input by emitting an empty result (-> NO_DATA).
# The "_taxid_" literal in the paths disambiguates samples from taxids.
# ================================================================================================
rule blast_pair:
    input:
        flag = FLAG_DIR + "/{sample}.extracted",
    output:
        r1 = BLAST_TREE + "/blast_validation_{sample}_{taxid}/{sample}_taxid_{taxid}_R1_blast_results.tsv",
        r2 = BLAST_TREE + "/blast_validation_{sample}_{taxid}/{sample}_taxid_{taxid}_R2_blast_results.tsv",
    params:
        in_r1      = lambda wc: fasta(wc.sample, wc.taxid, "R1"),
        in_r2      = lambda wc: fasta(wc.sample, wc.taxid, "R2"),
        blastn     = config["blastn"],
        seqtk      = config["seqtk"],
        db         = config["db"],
        max_reads  = config["max_reads"],
        max_target = config["max_target_seqs"],
    threads: 8
    resources:
        mem_mb  = 32000,
        runtime = 1440,   # minutes
    shell:
        "BLASTN={params.blastn} SEQTK={params.seqtk} DB={params.db} "
        "MAX_READS={params.max_reads} MAX_TARGET={params.max_target} THREADS={threads} "
        "bash workflow/scripts/blast_pair.sh {params.in_r1} {params.in_r2} {output.r1} {output.r2}"

# ================================================================================================
# CLASSIFY — aggregate every pair's blast results into one report.
# ================================================================================================
rule classify:
    input:
        blast_outputs()
    output:
        report = RESULTS + "/blast_false_positive_report.tsv",
        prov   = RESULTS + "/PROVENANCE.txt",
    params:
        python          = config["python"],
        blast_dir       = BLAST_TREE,
        taxid_list      = config["taxid_list"],
        taxid_names     = config["taxid_names"],
        threshold       = config["threshold"],
        min_match_reads = config["min_match_reads"],
        blastn          = config["blastn"],
        db              = config["db"],
        src             = SRC,
    shell:
        # 1) build the report, then 2) stamp provenance so every report traces to the exact code,
        #    settings, and reference DB that produced it (reproducible for re-runs and other projects).
        r"""
        {params.python} workflow/scripts/false_positive_detection.py \
            --blast_dir {params.blast_dir} --taxid_list {params.taxid_list} \
            --taxid_names {params.taxid_names} --output {output.report} \
            --threshold {params.threshold} --min_match_reads {params.min_match_reads}
        (
          echo "# ww-blast-validation run provenance"
          echo "date_utc:         $(date -u +%Y-%m-%dT%H:%M:%SZ)"
          echo "detection_source: {params.src}"
          echo "host:             $(hostname)"
          echo "report:           {output.report}"
          echo
          echo "## git (code version)"
          echo "commit:   $(git rev-parse HEAD 2>/dev/null || echo NOT_A_GIT_CHECKOUT)"
          echo "describe: $(git describe --always --dirty --tags 2>/dev/null || echo n/a)"
          echo "uncommitted changes (empty line below = clean working tree):"
          git status --porcelain 2>/dev/null
          echo
          echo "## blast database (reference version)"
          echo "db_path: {params.db}"
          "$(dirname {params.blastn})/blastdbcmd" -db {params.db} -info 2>&1 || echo "blastdbcmd -info failed"
        ) > {output.prov}
        cp config/config.yaml "$(dirname {output.report})/config.snapshot.yaml"
        echo "provenance -> {output.prov}"
        """
