# ww-blast-validation — Snakemake pipeline
# BLAST-validate candidate pathogen detections (per sample x taxid): extract the reads the detector
# assigned to that taxid -> subsample -> blastn vs nt -> classify TRUE/FALSE positive.
#
# Detection-source agnostic: `detection_source` (kraken | bowtie) selects the method-specific EXTRACT
# rule and routes the whole output tree into results/<source>/, so kraken and bowtie candidate sets
# never collide. Everything downstream of extraction (blast, classify) is shared.
#
# Pipeline:  extract  ->  blast_pair  ->  classify
#   extract     per (sample,taxid): pull the taxid's reads from the Kraken2 output + FASTQs -> FASTAs
#   blast_pair  per (sample,taxid): subsample to max_reads, blastn vs nt
#   classify    aggregate all pairs -> blast_false_positive_report.tsv
#
# Run (from repo root, on the cluster):
#   snakemake -p --profile profiles/slurm
# Dry run / DAG (no executor needed):
#   snakemake -n
import os
import pandas as pd

configfile: "config/config.yaml"

SRC        = config["detection_source"]                       # "kraken" or "bowtie"
RESULTS    = config["results_dir"].rstrip("/") + "/" + SRC
FASTA_TREE = RESULTS + "/fasta"                               # extracted per-pair FASTAs land here
BLAST_TREE = RESULTS + "/blast"

wildcard_constraints:
    taxid  = r"\d+",
    sample = r"[A-Za-z0-9]+",

# ---- candidate (sample, taxid) pairs from the list -----------------------------------------------
_df = pd.read_csv(config["taxid_list"], sep="\t", header=None, names=["sample", "taxid"], dtype=str)
_df = _df.dropna()
PAIRS   = [(r.sample, r.taxid) for r in _df.itertuples()]
SAMPLES = sorted(_df["sample"].unique())

def fasta(s, t, read):
    return f"{FASTA_TREE}/blast_validation_{s}_{t}/{s}_taxid_{t}_{read}.fasta"

def blast_outputs():
    out = []
    for s, t in PAIRS:
        d = f"{BLAST_TREE}/blast_validation_{s}_{t}"
        out += [f"{d}/{s}_taxid_{t}_R1_blast_results.tsv", f"{d}/{s}_taxid_{t}_R2_blast_results.tsv"]
    return out

rule all:
    input:
        RESULTS + "/blast_false_positive_report.tsv"

# ================================================================================================
# EXTRACT — method-specific, switched by detection_source. Regenerates the per-(sample,taxid) FASTAs
# that scratch retention purged. Each variant must produce the SAME output paths (fasta(s,t,read)),
# so blast_pair/classify stay source-agnostic.
# ================================================================================================
if SRC == "kraken":
    # Pull the reads Kraken2 assigned to {taxid} (incl. children) from {sample}'s .kraken + FASTQs.
    rule extract:
        input:
            kraken  = config["kraken_dir"] + "/{sample}.kraken",
            kreport = config["kraken_dir"] + "/{sample}.kreport",
            r1_fq   = config["fastq_dir"]  + "/{sample}_R1.fastq.gz",
            r2_fq   = config["fastq_dir"]  + "/{sample}_R2.fastq.gz",
        output:
            r1 = FASTA_TREE + "/blast_validation_{sample}_{taxid}/{sample}_taxid_{taxid}_R1.fasta",
            r2 = FASTA_TREE + "/blast_validation_{sample}_{taxid}/{sample}_taxid_{taxid}_R2.fasta",
        params:
            python      = config["python"],
            krakentools = config["krakentools"],
            seqtk       = config["seqtk"],
        resources:
            mem_mb  = 16000,
            runtime = 240,   # minutes
        shell:
            "PYTHON={params.python} KRAKENTOOLS={params.krakentools} SEQTK={params.seqtk} "
            "bash workflow/scripts/extract_kraken.sh {wildcards.sample} {wildcards.taxid} "
            "{input.kraken} {input.kreport} {input.r1_fq} {input.r2_fq} {output.r1} {output.r2}"

elif SRC == "bowtie":
    # Placeholder: a bowtie extract rule (same output paths) goes here. Kept as an explicit branch so
    # kraken-vs-bowtie stays a config switch, not a fork. Not yet implemented.
    raise WorkflowError(
        "detection_source: bowtie — extract rule not implemented yet. "
        "Add a bowtie extract rule producing fasta(sample, taxid, read), then remove this guard."
    )
else:
    raise WorkflowError(f"detection_source must be 'kraken' or 'bowtie', got: {SRC!r}")

# ================================================================================================
# BLAST — one job per (sample, taxid). The "_taxid_" literal disambiguates samples with underscores.
# ================================================================================================
rule blast_pair:
    input:
        r1 = fasta("{sample}", "{taxid}", "R1"),
        r2 = fasta("{sample}", "{taxid}", "R2"),
    output:
        r1 = BLAST_TREE + "/blast_validation_{sample}_{taxid}/{sample}_taxid_{taxid}_R1_blast_results.tsv",
        r2 = BLAST_TREE + "/blast_validation_{sample}_{taxid}/{sample}_taxid_{taxid}_R2_blast_results.tsv",
    params:
        blastn     = config["blastn"],
        seqtk      = config["seqtk"],
        db         = config["db"],
        max_reads  = config["max_reads"],
        max_target = config["max_target_seqs"],
    threads: 8
    resources:
        mem_mb  = 32000,
        runtime = 1440,   # minutes
    shell:
        "BLASTN={params.blastn} SEQTK={params.seqtk} DB={params.db} "
        "MAX_READS={params.max_reads} MAX_TARGET={params.max_target} THREADS={threads} "
        "bash workflow/scripts/blast_pair.sh {input.r1} {input.r2} {output.r1} {output.r2}"

# ================================================================================================
# CLASSIFY — aggregate every pair's blast results into one report.
# ================================================================================================
rule classify:
    input:
        blast_outputs()
    output:
        RESULTS + "/blast_false_positive_report.tsv"
    params:
        python          = config["python"],
        blast_dir       = BLAST_TREE,
        taxid_list      = config["taxid_list"],
        taxid_names     = config["taxid_names"],
        threshold       = config["threshold"],
        min_match_reads = config["min_match_reads"],
    shell:
        "{params.python} workflow/scripts/false_positive_detection.py "
        "--blast_dir {params.blast_dir} --taxid_list {params.taxid_list} "
        "--taxid_names {params.taxid_names} --output {output} "
        "--threshold {params.threshold} --min_match_reads {params.min_match_reads}"
